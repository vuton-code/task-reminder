# Replace hostname and certificate paths before deployment.
# Never record query strings, verification/reset tokens or invitation tokens.
map $uri $safe_path {
    ~^/accounts/(verify|reset)/ /accounts/proof/[redacted];
    ~^/invitations/ /invitations/[redacted];
    default $uri;
}
log_format safe '$remote_addr $request_method $safe_path $status';
server {
    listen 80;
    server_name tasks.example.test;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name tasks.example.test;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    access_log /var/log/nginx/access.log safe;
    # Error logs can include raw request URLs; keep request-bearing diagnostics off.
    error_log /dev/null;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
